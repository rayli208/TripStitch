rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Trips ──
    // Anyone can read (public trip pages, profiles, search)
    // Create: only if you set yourself as the owner
    // Update/Delete: only the original owner
    match /trips/{tripId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── User's profile ──
    // Anyone can read (needed for public profile pages /u/{username})
    // Only the owner can write
    match /users/{userId}/profile/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Blog Posts ──
    // Read: public + unlisted posts are world-readable; drafts/private only by owner.
    //   Queries must filter visibility == 'public' (or userId == auth.uid) to be provable.
    // Create: only if you set yourself as the owner
    // Update: owner can edit anything; anyone (incl. anonymous readers) may
    //   increment the `reads` counter by exactly 1 and touch nothing else.
    // Delete: only the original owner
    match /blogs/{blogId} {
      allow read: if resource.data.visibility in ['public', 'unlisted']
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if (request.auth != null
                        && resource.data.userId == request.auth.uid)
                    || (resource.data.visibility in ['public', 'unlisted']
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
                        && request.resource.data.reads is int
                        && request.resource.data.reads == resource.data.get('reads', 0) + 1);
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── Blog Slug Index ──
    // Maps slug -> blogId for O(1) lookup
    match /blogSlugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // ── Routes cache ──
    // Shared global cache of road-following route geometries. Same physical
    // route between two stops gets fetched from OpenRouteService once, then
    // every subsequent user reads it from Firestore for free (vs. another
    // ORS call against the daily quota).
    //
    // Read: public (geometry is not sensitive)
    // Create / Update: authenticated users only, payload must look like a
    //   route doc, geometry hard-capped at 4000 numbers (2000 [lng,lat] pairs)
    //   to prevent storage bloat.
    // Delete: blocked — let TTL / staleness check handle expiry instead.
    match /routes/{routeId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.resource.data.flatCoords is list
                            && request.resource.data.flatCoords.size() >= 4
                            && request.resource.data.flatCoords.size() <= 4000
                            && request.resource.data.profile is string
                            && request.resource.data.fetchedAt is number;
      allow delete: if false;
    }

    // ── Username index ──
    // Anyone can read (username availability checks, resolving usernames)
    // Create: only if the uid field matches the authenticated user
    // Update/Delete: only if you're the current owner
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
